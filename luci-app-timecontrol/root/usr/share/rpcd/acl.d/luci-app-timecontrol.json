{
   "luci-app-timecontrol": {
	"description": "Grant UCI Internet time control for luci-app-timecontrol",
	"read": {

            "ubus": {
					"file": ["exec", "list", "stat", "read"],
					"uci": [ "*" ],
					"timecontrol": ["*"]
            },
		    "file": {
      				"/bin/ps": ["exec"],
      				"/usr/libexec/timecontrol-call": ["exec"],
      				"/var/log/timecontrol.log": ["read"]
      			}
	},
	"write": {
            "ubus": {
                "timecontrol": ["*"],
                "uci": ["*"]
      }
    }
  }
}
